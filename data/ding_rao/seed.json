  "passages": [
    {
      "id": "poem_full",
      "source_id": "liuyong",
      "focus_subject_id": "speaker",
      "text": "伫倚危楼风细细，望极春愁，黯黯生天际。草色烟光残照里，无言谁会凭阑意。拟把疏狂图一醉，对酒当歌，强乐还无味。衣带渐宽终不悔，为伊消得人憔悴。",
      "time_label": "词内叙事顺序；无可核算持续时间",
      "coverage": "selected_excerpt",
      "annotation_note": "AI 辅助研究标注。原文可核；解释、语义标签与动作映射尚未独立人工复核。",
